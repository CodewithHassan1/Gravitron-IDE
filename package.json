{
  "name": "gravitron-ide-monorepo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,json}\"",
    "test": "turbo run test",
    "prepare": "husky && husky install",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "package": "pnpm build && pnpm --filter @ag/electron run package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@playwright/test": "^1.61.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "husky": "^8.0.0",
    "jose": "^5.10.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "tsx": "^4.23.15",
    "turbo": "^1.13.2",
    "typescript": "5.4.5",
    "vitest": "^1.0.0"
  },
  "overrides": {
    "typescript": "5.4.5"
  },
  "resolutions": {
    "typescript": "5.4.5"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
