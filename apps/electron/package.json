{
  "name": "@ag/electron",
  "version": "1.0.0",
  "description": "Gravitron IDE Electron Main Process",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build -c vite.preload.config.ts && vite build -c vite.main.config.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "package": "electron-builder build --win"
  },
  "dependencies": {
    "@ag/ai-providers": "workspace:^",
    "@ag/logger": "workspace:^",
    "@ag/platform": "workspace:^",
    "@ag/protocol": "workspace:^",
    "@ag/worker-ai": "workspace:^",
    "chokidar": "^3.6.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@ag/eslint-config": "workspace:^",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "electron": "^29.0.0",
    "eslint": "^8.57.0",
    "jose": "^5.10.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "build": {
    "appId": "com.personalagent.ide",
    "productName": "Gravitron IDE",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
