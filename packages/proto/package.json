{
  "name": "@ag/proto",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gen/*.js": {
      "types": "./dist/gen/*.d.ts",
      "default": "./dist/gen/*.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "default": "./dist/gen/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist gen",
    "lint": "eslint \"src/**/*.ts*\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ag/eslint-config": "workspace:*",
    "@ag/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "1.7.0"
  }
}
