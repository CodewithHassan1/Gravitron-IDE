# ==============================================================================
# Gravitron IDE - Production Environment Variables Template (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# --- Domain & Ingress Configuration ---
# Set to your publicly reachable domain for automatic Let's Encrypt TLS
# Example: gateway.yourcompany.com
GATEWAY_DOMAIN=gateway.yourdomain.com

# --- PostgreSQL Datastore Credentials ---
POSTGRES_USER=ag_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD_MIN_32_CHARS
POSTGRES_DB=ag_ide

# --- Redis Datastore Credentials ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# --- Platform JWT Symmetric Secret (Used for Internal HMAC/Session Validation) ---
# Must be at least 32 characters long
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING_EXAMPLE_HEX_OR_BASE64

# --- Cryptographic Asymmetric Keys (ES256 - ECDSA P-256) ---
# NOTE: Both Auth and Gateway strictly require ES256 PKCS8 PEM formatted keys.
# Ephemeral keys are strictly forbidden in production.
#
# To generate a compliant ES256 keypair on Linux/macOS/Git Bash:
#   openssl ecparam -name prime256v1 -genkey -noout -out ec_private.key
#   openssl pkcs8 -topk8 -nocrypt -in ec_private.key -out pkcs8_private.key
#
# Replace linebreaks with \n or pass as a multiline secret:
AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_AUTH_ES256_PKCS8_PRIVATE_KEY\n-----END PRIVATE KEY-----"
AUTH_KID=key-v1

GATEWAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_GATEWAY_ES256_PKCS8_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# --- OIDC / Token Verification Contract ---
AUTH_ISSUER=https://auth.ag-ide.local
AUTH_AUDIENCE=ag-ide-platform
AGENT_HOST_SECRET=REPLACE_WITH_STRONG_AGENT_HOST_SECRET_MIN_32_CHARS

# --- Transactional Email / SMTP Configuration ---
# Connection URL format: smtp://user:password@host:port (or smtps://)
# Example for Sendgrid: smtp://apikey:SG.xxxx@smtp.sendgrid.net:587
# Example for AWS SES: smtp://AKIAxxxx:secret@email-smtp.us-east-1.amazonaws.com:587
SMTP_URL=smtp://user:password@smtp.yourprovider.com:587
FROM_EMAIL=noreply@yourdomain.com

# Base URL included in verification and password-reset emails sent to users
FRONTEND_URL=https://ide.yourdomain.com
